#!/bin/sh
# Node state lives apart from the Node server's ~/.t3/userdata.
export T3_HOME="${T3_HOME:-$HOME/.t3/elixir}"

# Distribution is never started by the release script: a machine that joined a
# cluster boots with its own TLS distribution flags, others run without it.
export RELEASE_DISTRIBUTION=none
if [ -f "$T3_HOME/cluster/vm.args" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -args_file $T3_HOME/cluster/vm.args"
fi
