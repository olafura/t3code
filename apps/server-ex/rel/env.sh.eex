#!/bin/sh
# Node state lives apart from the Node server's ~/.t3/userdata.
export T3_HOME="${T3_HOME:-$HOME/.t3/elixir}"

# Distribution is not started by the release script unless asked for
# (RELEASE_DISTRIBUTION=sname, e.g. to reach the node with `mix t3.upgrade`): a
# machine that joined a cluster boots with its own TLS distribution flags.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ -f "$T3_HOME/cluster/vm.args" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -args_file $T3_HOME/cluster/vm.args"
fi
